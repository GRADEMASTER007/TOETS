rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string
        && data.role in ['user', 'vendor']
        && data.keys().hasAll(['uid', 'email', 'role']);
    }

    function isValidListing(data) {
      return data.ownerId == request.auth.uid
        && data.title is string && data.title.size() <= 100
        && data.price is number && data.price >= 0
        && data.status in ['active', 'sold', 'deleted']
        && data.keys().hasAll(['ownerId', 'title', 'price', 'pillar', 'status']);
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
    }

    match /listings/{listingId} {
      allow read: if true; // Public marketplace
      allow create: if isSignedIn() && isValidListing(incoming());
      allow update: if isSignedIn() && isOwner(existing().ownerId) && isValidListing(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'price', 'status', 'updatedAt']);
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in existing().participantIds);
      allow create: if isSignedIn() && (request.auth.uid in incoming().participantIds);
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
      allow create: if isSignedIn() && (request.auth.uid == incoming().senderId)
        && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
    }
  }
}
